[Unit]
Description=sre-agent (read-only metrics collector with flight recorder)
After=network.target

[Service]
ExecStart=/usr/local/bin/sre-agent -vm http://DATA_NODE_IP:8428 -listen :9911
Restart=always
# 只讀加固
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadOnlyPaths=/
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
